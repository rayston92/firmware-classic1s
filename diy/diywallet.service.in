[Unit]
Description=DIY hardware wallet (OneKey Classic firmware, DIY build)
# Before every start, restarts included, diywallet-check.service runs as root:
# swap off, the random number generator check (hwrng-check), text console off
# the screen. If it fails, the wallet does not start.
Requires=diywallet-check.service
After=diywallet-check.service

[Service]
User=diywallet
Group=diywallet
SupplementaryGroups=video input
@STORAGE@
EnvironmentFile=-/etc/diywallet.conf
ExecStart=/opt/diywallet/wallet
Restart=always
RestartSec=2

# Keep the wallet's memory out of swap on the memory card: swap is off (install.sh and
# diywallet-check.service),
# the wallet locks its memory in RAM, and memory cgroups (where enabled) forbid
# swapping it. No core dumps, ever.
MemorySwapMax=0
LimitMEMLOCK=infinity
LimitCORE=0
# Only what it needs: the screen, the keys, the hardware random number
# generator, and a socket on this Pi. DevicePolicy= applies to every program
# in this service, even ones run as root; that is why the checks above have a
# service of their own.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
DevicePolicy=closed
DeviceAllow=char-fb rw
DeviceAllow=char-input r
DeviceAllow=/dev/hwrng r
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target

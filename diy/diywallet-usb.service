[Unit]
Description=DIY hardware wallet USB connection
After=diywallet.service
Wants=diywallet.service
# Restarting the wallet by hand restarts the USB connection with it.
PartOf=diywallet.service

[Service]
ExecStartPre=/opt/diywallet/usb-gadget.sh start
ExecStart=/usr/bin/python3 /opt/diywallet/usb-relay.py
ExecStopPost=/opt/diywallet/usb-gadget.sh stop
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
